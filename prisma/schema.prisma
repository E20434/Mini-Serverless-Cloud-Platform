generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Still smaller than the full target schema from Part 4: no Deployment
// table yet - Worker state deliberately lives in Redis (Phase 8), not
// here. Invocation earns its place NOW (Phase 10) because durable,
// per-tenant invocation history is finally meaningful and worth writing.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  functions Function[]
  apiKeys   ApiKey[]

  @@map("users")
}

// keyHash is SHA-256, not bcrypt - see the Phase 9 write-up for why an
// API key (checked on every request, needs a fast indexed lookup) is
// hashed differently than a password (checked rarely, needs slowness as
// its actual defense).
model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  keyHash    String    @unique @map("key_hash")
  name       String
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Function {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  memoryMb  Int      @default(128) @map("memory_mb")
  timeoutMs Int      @default(3000) @map("timeout_ms")
  createdAt DateTime @default(now()) @map("created_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    FunctionVersion[]
  builds      Build[]
  invocations Invocation[]

  // THE actual Phase 9 schema change: names are unique PER USER now, not
  // globally. Two different users can each have a function named
  // "hello" - exactly the real-world requirement multi-tenancy implies,
  // and exactly what a bare `name String @unique` could never support.
  @@unique([userId, name])
  @@map("functions")
}

// An immutable build artifact. There is deliberately no "active"/
// "inactive" status column yet - the newest successfully built version
// (highest versionNumber) is automatically the one invoked. Explicit
// promotion/rollback between versions is a real feature we're choosing
// not to half-build until a phase actually needs it.
model FunctionVersion {
  id            String   @id @default(uuid())
  functionId    String   @map("function_id")
  versionNumber Int      @map("version_number")
  imageTag      String   @map("image_tag")
  createdAt     DateTime @default(now()) @map("created_at")

  function    Function     @relation(fields: [functionId], references: [id], onDelete: Cascade)
  invocations Invocation[]

  @@unique([functionId, versionNumber])
  @@map("function_versions")
}

// The operational record of ONE build attempt. status is a plain string
// rather than a Postgres enum for now (PENDING | RUNNING | SUCCESS |
// FAILED) - deliberately simple; an enum is a one-line upgrade later if
// we ever need the database itself to reject an invalid status.
model Build {
  id              String    @id @default(uuid())
  functionId      String    @map("function_id")
  sourceObjectKey String    @map("source_object_key")
  status          String
  imageTag        String?   @map("image_tag")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  // NULL until the outbox relay (build-outbox-relay.service.ts) has
  // published this build to the Redis stream. Phase 6's dual-write
  // safety net: submitBuild() writes ONLY this row; the relay is what
  // notices it and dispatches it, on its own schedule, independently.
  publishedToStreamAt DateTime? @map("published_to_stream_at")

  function Function @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@map("builds")
}

// One row per invocation ATTEMPT that actually reached the dispatch
// layer - not every rejected HTTP request. A 404 (unknown function) or
// 409 (no built version) never gets this far; those are platform
// validation failures, not invocation attempts in the AWS-Lambda sense.
// coldStart is always true today, honestly - this system has never
// built container/warm-pool reuse (that's a Scaling-phase concern) - the
// column exists so the metric has somewhere to go the moment it does.
model Invocation {
  id            String    @id @default(uuid())
  functionId    String    @map("function_id")
  versionId     String?   @map("version_id") // null for the NO_WORKER case - dispatch never got far enough to know which version would have run
  requestId     String    @unique @map("request_id")
  status        String // SUCCESS | ERROR | TIMEOUT | NO_WORKER
  coldStart     Boolean   @default(true) @map("cold_start")
  durationMs    Int       @map("duration_ms")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")

  function Function        @relation(fields: [functionId], references: [id], onDelete: Cascade)
  version  FunctionVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  // The hot query from Part 4's original design, now real: "recent
  // invocations for this function, newest first."
  @@index([functionId, createdAt(sort: Desc)])
  @@map("invocations")
}
