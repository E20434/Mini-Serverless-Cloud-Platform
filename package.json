{
  "name": "mini-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "A small, from-scratch serverless platform, built in phases",
  "scripts": {
    "start": "tsx src/run.ts",
    "start:container": "tsx src/run-container.ts",
    "start:api": "node --env-file=.env -r ts-node/register src/main.ts",
    "start:worker": "node --env-file=.env -r ts-node/register src/worker-main.ts",
    "docker:build": "docker build -t mini-cloud-runtime:latest ./runtime",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.19.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
