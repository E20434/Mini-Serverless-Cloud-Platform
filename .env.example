# Copy to .env. These are trivial local-only dev credentials matching
# docker-compose.yml - never reuse them anywhere real.
DATABASE_URL="postgresql://mini_cloud:mini_cloud@localhost:5432/mini_cloud?schema=public"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="mini_cloud"
S3_SECRET_ACCESS_KEY="mini_cloud_secret"
S3_BUCKET="mini-cloud-function-source"

REDIS_URL="redis://localhost:6379"

JWT_SECRET="local-dev-only-secret-do-not-use-in-production"
